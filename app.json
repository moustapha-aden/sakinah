{
  "expo": {
    "name": "sakinah",
    "slug": "sakinah",
    "scheme": "sakinah",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.moustapha.sakinah"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#F9FBFC",
          "dark": {
            "backgroundColor": "#0F1419"
          }
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Sakīnah utilise votre position pour calculer les horaires de prière exacts de votre lieu."
        }
      ],
      [
        "expo-notifications",
        {
          "sounds": [
            "./assets/audio/notification_chime.wav"
          ]
        }
      ],
      "expo-audio"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "970df91c-1d9f-4d0c-ac99-d1f24ace0e1b"
      }
    },
    "owner": "moustapha_aden"
  }
}
